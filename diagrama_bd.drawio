"pauta" target="metrica"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e13a" value="1" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];labelBackgroundColor=#ffffff;fontSize=11;fontStyle=1;fontColor=#b91c1c;" vertex="1" connectable="0" parent="e13"><mxGeometry x="-0.8" relative="1" as="geometry"><mxPoint x="0" y="-11" as="offset"/></mxGeometry></mxCell><mxCell id="e13b" value="0..*" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];labelBackgroundColor=#ffffff;fontSize=11;fontStyle=1;fontColor=#b91c1c;" vertex="1" connectable="0" parent="e13"><mxGeometry x="0.8" relative="1" as="geometry"><mxPoint x="0" y="-11" as="offset"/></mxGeometry></mxCell><mxCell id="e13r" value="mide" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];labelBackgroundColor=#ffffff;fontSize=11;fontStyle=2;fontColor=#374151;" vertex="1" connectable="0" parent="e13"><mxGeometry relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="titulo" value="Sistema de Publicidad Universitaria - Grupo 13 - Modelo de la base de datos (db_grupo13sc)" style="text;html=1;fontSize=18;fontStyle=1;fontColor=#0b3d91;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="-20" width="900" height="34" as="geometry"/></mxCell><mxCell id="leyenda" value="&lt;b&gt;Leyenda&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#0b3d91&quot;&gt;&amp;#9632;&lt;/font&gt; Tabla &amp;nbsp; &lt;font color=&quot;#b8860b&quot;&gt;&amp;#9632;&lt;/font&gt; Tabla intermedia (resuelve una relación muchos a muchos) &amp;nbsp; &lt;font color=&quot;#6b7280&quot;&gt;&amp;#9632;&lt;/font&gt; Sin relaciones (lista del HELP)&lt;br&gt;PK = llave primaria. Las FK no se muestran: las representan las líneas.&lt;br&gt;1 = uno obligatorio &amp;middot; 0..1 = cero o uno &amp;middot; 0..* = cero o muchos &amp;middot; 1..* = uno o muchos&lt;br&gt;CU8 Reportes no tiene tabla propia: consulta las demás." style="text;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#f9fafb;strokeColor=#d1d5db;fontSize=12;fontColor=#111827;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="440" y="990" width="800" height="100" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>